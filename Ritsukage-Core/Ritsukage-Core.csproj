    <Compile Remove="Library\Microsoft\**" />
    <Compile Remove="Library\Pixiv\**" />
    <EmbeddedResource Remove="Library\FFXIV\XivAPI\**" />
    <EmbeddedResource Remove="Library\Microsoft\**" />
    <EmbeddedResource Remove="Library\Pixiv\**" />
    <None Remove="Library\FFXIV\XivAPI\**" />
    <None Remove="Library\Microsoft\**" />
    <None Remove="Library\Pixiv\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Discord\Commands\NeteaseCloudMusic.cs" />
    <Compile Remove="Discord\Commands\Pixiv.cs" />
    <Compile Remove="QQ\Commands\BingChat.cs" />
    <Compile Remove="QQ\Commands\ChatGPT.cs" />
    <Compile Remove="QQ\Commands\ContentModerator.cs" />
    <Compile Remove="QQ\Commands\FFXIV.cs" />
    <Compile Remove="QQ\Commands\NeteaseCloudMusic.cs" />
    <Compile Remove="QQ\Commands\OCR.cs" />
    <Compile Remove="QQ\Commands\Pixiv.cs" />
    <Compile Remove="QQ\Commands\Speech.cs" />
    <Compile Remove="QQ\Events\SmartPixivLink.cs" />
    <Compile Remove="QQ\Service\ContentModeratorForSB447Service.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AngouriMath" Version="1.4.0-preview.3" />
    <PackageReference Include="Betalgo.OpenAI" Version="8.7.2" />
    <PackageReference Include="CodeHollow.FeedReader" Version="1.2.6" />
    <PackageReference Include="Discord.Net" Version="3.16.0" />
    <PackageReference Include="DnsClient" Version="1.8.0" />
    <PackageReference Include="Downloader" Version="3.3.1" />
    <PackageReference Include="Meowtrix.PixivApi" Version="0.3.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="4.12.0-3.final" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="NetCoreHTMLToImage" Version="1.1.1.7" />
    <PackageReference Include="NeteaseCloudMusicApi" Version="3.25.3.10000" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3">
      <TreatAsUsed>true</TreatAsUsed>
    </PackageReference>
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="ReverseMarkdown" Version="4.6.0" />
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.6" />
    <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="2.1.4">
      <TreatAsUsed>true</TreatAsUsed>
    </PackageReference>
    <PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
	<PackageReference Include="NLua" Version="1.7.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Acquisition\Acquisition.csproj" />
